  "tags": [
    {
      "name": "认证",
      "description": "登录、退出与当前身份；会话保存在服务端，Cookie 只带会话标识"
    },
    {
      "name": "角色",
      "description": "角色查询，供用户管理选择与筛选"
    },
    {
