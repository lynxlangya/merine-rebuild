          "loginName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "unitCode": {
            "type": "string"
          },
          "unitName": {
            "type": "string"
          },
          "roleCodes": {
            "type": "array",
            "description": "角色编码，按编码升序，与 roleNames 下标一一对应",
