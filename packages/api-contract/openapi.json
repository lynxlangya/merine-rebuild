        "required": [
          "displayName",
          "id",
          "loginName",
          "roleCodes",
          "roleNames",
          "status",
          "unitCode",
          "unitName",
          "version"
        ]
      },
      "CreateUser": {
        "type": "object",
        "properties": {
          "loginName": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9.]{4,32}$"
