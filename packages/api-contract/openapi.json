            "minItems": 1
          },
          "newPassword": {
            "type": "string",
            "description": "重置密码；省略或为 null 表示不修改；至少 6 个字符，UTF-8 编码不超过 72 字节",
            "maxLength": 72,
            "minLength": 6
          }
        },
        "required": [
          "displayName",
          "roleCodes",
          "unitCode",
          "version"
        ]
      },
