          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": { "default": 20, "format": "int32", "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePageResultLinkedIntelligenceTask"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": ["task-intelligence-controller"]
      },
      "post": {
