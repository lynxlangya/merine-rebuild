        "operationId": "taskIntelligenceContext",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseIntelligenceTaskContext" }
              }
            },
            "description": "OK"
          }
        },
        "tags": ["task-intelligence-controller"]
      }
    },
    "/api/intelligence-topics/{id}/tasks": {
