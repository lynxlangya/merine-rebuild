{
  "components": {
    "schemas": {
      "ApiResponseDataSourceCheckResult": {
        "properties": {
          "code": { "type": "string" },
          "data": { "$ref": "#/components/schemas/DataSourceCheckResult" },
          "fieldErrors": {
            "description": "字段级校验错误；无字段错误时为 null",
            "items": { "$ref": "#/components/schemas/FieldError" },
            "type": "array"
          },
          "message": { "type": "string" },
          "requestId": { "type": "string" }
        },
        "required": ["code", "data", "message", "requestId"],
        "type": "object"
      },
      "ApiResponseDataSourceView": {
        "properties": {
          "code": { "type": "string" },
          "data": { "$ref": "#/components/schemas/DataSourceView" },
          "fieldErrors": {
            "description": "字段级校验错误；无字段错误时为 null",
            "items": { "$ref": "#/components/schemas/FieldError" },
            "type": "array"
          },
          "message": { "type": "string" },
          "requestId": { "type": "string" }
        },
        "required": ["code", "data", "message", "requestId"],
        "type": "object"
      },
      "ApiResponsePageResultDataSourceView": {
        "properties": {
          "code": { "type": "string" },
          "data": { "$ref": "#/components/schemas/PageResultDataSourceView" },
          "fieldErrors": {
            "description": "字段级校验错误；无字段错误时为 null",
            "items": { "$ref": "#/components/schemas/FieldError" },
            "type": "array"
          },
          "message": { "type": "string" },
          "requestId": { "type": "string" }
        },
        "required": ["code", "data", "message", "requestId"],
        "type": "object"
      },
      "ApiResponseQueryScopeDetail": {
        "properties": {
          "code": { "type": "string" },
          "data": { "$ref": "#/components/schemas/QueryScopeDetail" },
          "fieldErrors": {
            "description": "字段级校验错误；无字段错误时为 null",
            "items": { "$ref": "#/components/schemas/FieldError" },
            "type": "array"
          },
          "message": { "type": "string" },
          "requestId": { "type": "string" }
        },
        "required": ["code", "data", "message", "requestId"],
        "type": "object"
      },
      "CheckDataSourceDraft": {
        "properties": {
          "databaseName": { "maxLength": 64, "minLength": 0, "type": "string" },
          "dbType": { "enum": ["MYSQL"], "type": "string" },
          "host": { "maxLength": 253, "minLength": 0, "type": "string" },
          "id": { "maxLength": 80, "minLength": 0, "type": "string" },
          "password": { "maxLength": 128, "minLength": 0, "type": "string", "writeOnly": true },
          "port": { "format": "int32", "maximum": 65535, "minimum": 1, "type": "integer" },
          "username": { "maxLength": 64, "minLength": 0, "type": "string" },
          "views": {
            "items": { "maxLength": 64, "minLength": 0, "type": "string" },
            "maxItems": 50,
            "minItems": 0,
            "type": "array"
          }
        },
        "required": ["databaseName", "dbType", "host", "port", "username"],
        "type": "object"
      },
      "DataSourceCheckResult": {
        "properties": {
          "checkedAt": { "format": "date-time", "type": "string" },
          "detectedViews": { "items": { "type": "string" }, "type": "array" },
          "message": { "type": "string" },
          "outcome": {
            "enum": [
              "PASSED",
              "CONNECTION_FAILED",
              "WRITE_PRIVILEGE",
              "AUTHORIZATION_UNCONFIRMED",
              "VIEW_DENIED"
            ],
            "type": "string"
          },
          "sourceVersion": { "format": "int32", "type": "integer" },
          "viewColumns": {
            "items": { "$ref": "#/components/schemas/DataSourceViewColumn" },
            "type": "array"
          }
        },
        "type": "object"
      },
      "DataSourceStatusChange": {
        "properties": {
          "status": { "enum": ["ENABLED", "DISABLED"], "type": "string" },
          "version": { "format": "int32", "minimum": 0, "type": "integer" }
        },
        "required": ["status", "version"],
        "type": "object"
      },
      "DataSourceView": {
        "properties": {
          "databaseName": { "type": "string" },
          "dbType": { "enum": ["MYSQL"], "type": "string" },
          "host": { "type": "string" },
          "id": { "type": "string" },
          "lastCheckAt": { "format": "date-time", "type": "string" },
          "lastCheckMessage": { "type": "string" },
          "lastCheckStatus": {
            "enum": [
              "PASSED",
              "CONNECTION_FAILED",
              "WRITE_PRIVILEGE",
              "AUTHORIZATION_UNCONFIRMED",
              "VIEW_DENIED"
            ],
            "type": "string"
          },
          "name": { "type": "string" },
          "port": { "format": "int32", "type": "integer" },
          "remark": { "type": "string" },
          "semanticVersion": { "format": "int32", "type": "integer" },
          "status": { "enum": ["ENABLED", "DISABLED"], "type": "string" },
          "updatedAt": { "format": "date-time", "type": "string" },
          "username": { "type": "string" },
          "version": { "format": "int32", "type": "integer" },
          "views": { "items": { "type": "string" }, "type": "array" }
        },
        "type": "object"
      },
      "DataSourceViewColumn": {
        "properties": {
          "comment": { "type": "string" },
          "name": { "type": "string" },
          "nullable": { "type": "boolean" },
          "type": { "type": "string" }
        },
        "type": "object"
      },
      "FieldError": {
        "properties": { "field": { "type": "string" }, "message": { "type": "string" } },
        "required": ["field", "message"],
        "type": "object"
      },
      "PageResultDataSourceView": {
        "properties": {
          "items": { "items": { "$ref": "#/components/schemas/DataSourceView" }, "type": "array" },
          "page": { "format": "int32", "type": "integer" },
          "pageSize": { "format": "int32", "type": "integer" },
          "total": { "format": "int64", "type": "integer" }
        },
        "required": ["items", "page", "pageSize", "total"],
        "type": "object"
      },
      "QueryScopeColumn": {
        "properties": {
          "description": { "maxLength": 300, "minLength": 0, "type": "string" },
          "name": { "maxLength": 64, "minLength": 0, "type": "string" }
        },
        "required": ["name"],
        "type": "object"
      },
      "QueryScopeDetail": {
        "properties": {
          "meta": { "items": { "$ref": "#/components/schemas/ScopeViewMeta" }, "type": "array" },
          "source": { "$ref": "#/components/schemas/DataSourceView" }
        },
        "type": "object"
      },
      "ReplaceQueryScopeViews": {
        "properties": {
          "version": { "format": "int32", "minimum": 0, "type": "integer" },
          "views": {
            "items": { "maxLength": 64, "minLength": 0, "type": "string" },
            "maxItems": 50,
            "minItems": 0,
            "type": "array"
          }
        },
        "required": ["version", "views"],
        "type": "object"
      },
      "SaveDataSource": {
        "properties": {
          "databaseName": { "maxLength": 64, "minLength": 0, "type": "string" },
          "dbType": { "enum": ["MYSQL"], "type": "string" },
          "host": { "maxLength": 253, "minLength": 0, "type": "string" },
          "name": { "maxLength": 80, "minLength": 0, "type": "string" },
          "password": {
            "description": "新建必填；编辑留空保留原密码。只保存到服务端密文，不回显",
            "maxLength": 128,
            "minLength": 0,
            "type": "string",
            "writeOnly": true
          },
          "port": { "format": "int32", "maximum": 65535, "minimum": 1, "type": "integer" },
          "remark": { "maxLength": 300, "minLength": 0, "type": "string" },
          "username": { "maxLength": 64, "minLength": 0, "type": "string" },
          "version": { "format": "int32", "minimum": 0, "type": "integer" },
          "views": {
            "deprecated": true,
            "description": "已忽略：连接保存不修改允许查询的视图，请使用查询范围页",
            "items": { "deprecated": true, "maxLength": 64, "minLength": 0, "type": "string" },
            "maxItems": 50,
            "minItems": 0,
            "type": "array"
          }
        },
        "required": ["databaseName", "dbType", "host", "name", "port", "username"],
        "type": "object"
      },
      "SaveQueryScopeMetadata": {
        "properties": {
          "columns": {
            "items": { "$ref": "#/components/schemas/QueryScopeColumn" },
            "maxItems": 100,
            "minItems": 0,
            "type": "array"
          },
          "description": { "maxLength": 2000, "minLength": 0, "type": "string" },
          "displayName": { "maxLength": 80, "minLength": 0, "type": "string" },
          "semanticVersion": { "format": "int32", "minimum": 0, "type": "integer" },
          "version": { "format": "int32", "minimum": 0, "type": "integer" },
          "view": { "maxLength": 64, "minLength": 0, "type": "string" }
        },
        "required": ["semanticVersion", "version", "view"],
        "type": "object"
      },
      "ScopeColumnMeta": {
        "properties": { "description": { "type": "string" }, "name": { "type": "string" } },
        "type": "object"
      },
      "ScopeViewMeta": {
        "properties": {
          "columns": {
            "items": { "$ref": "#/components/schemas/ScopeColumnMeta" },
            "type": "array"
          },
          "description": { "type": "string" },
          "displayName": { "type": "string" },
          "view": { "type": "string" }
        },
        "type": "object"
      }
    }
  },
  "info": { "title": "OpenAPI definition", "version": "v0" },
  "openapi": "3.1.0",
  "paths": {
    "/api/agent/datasources": {
      "get": {
        "operationId": "dataSourceList",
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": { "default": "", "maxLength": 80, "minLength": 0, "type": "string" }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": { "default": 1, "format": "int32", "minimum": 1, "type": "integer" }
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 12,
              "format": "int32",
              "maximum": 60,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponsePageResultDataSourceView" }
              }
            },
            "description": "OK"
          }
        },
        "tags": ["数据源管理"]
      },
      "post": {
        "operationId": "dataSourceCreate",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SaveDataSource" } }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseDataSourceView" } }
            },
            "description": "Created"
          }
        },
        "tags": ["数据源管理"]
      }
    },
    "/api/agent/datasources/check": {
      "post": {
        "operationId": "dataSourceCheck",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CheckDataSourceDraft" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseDataSourceCheckResult" }
              }
            },
            "description": "OK"
          }
        },
        "tags": ["数据源管理"]
      }
    },
    "/api/agent/datasources/{id}": {
      "put": {
        "operationId": "dataSourceUpdate",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SaveDataSource" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseDataSourceView" } }
            },
            "description": "OK"
          }
        },
        "tags": ["数据源管理"]
      }
    },
    "/api/agent/datasources/{id}/check": {
      "post": {
        "operationId": "dataSourceCheckSaved",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseDataSourceCheckResult" }
              }
            },
            "description": "OK"
          }
        },
        "tags": ["数据源管理"]
      }
    },
    "/api/agent/datasources/{id}/status": {
      "post": {
        "operationId": "dataSourceUpdateStatus",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DataSourceStatusChange" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseDataSourceView" } }
            },
            "description": "OK"
          }
        },
        "tags": ["数据源管理"]
      }
    },
    "/api/agent/query-scopes": {
      "get": {
        "operationId": "queryScopeList",
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": { "default": "", "maxLength": 80, "minLength": 0, "type": "string" }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": { "default": 1, "format": "int32", "minimum": 1, "type": "integer" }
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 12,
              "format": "int32",
              "maximum": 60,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponsePageResultDataSourceView" }
              }
            },
            "description": "OK"
          }
        },
        "tags": ["查询范围管理"]
      }
    },
    "/api/agent/query-scopes/{id}": {
      "get": {
        "operationId": "queryScopeDetail",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseQueryScopeDetail" } }
            },
            "description": "OK"
          }
        },
        "tags": ["查询范围管理"]
      }
    },
    "/api/agent/query-scopes/{id}/inspect": {
      "post": {
        "operationId": "queryScopeInspect",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } },
          {
            "in": "query",
            "name": "view",
            "required": false,
            "schema": { "maxLength": 64, "minLength": 0, "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseDataSourceCheckResult" }
              }
            },
            "description": "OK"
          }
        },
        "tags": ["查询范围管理"]
      }
    },
    "/api/agent/query-scopes/{id}/metadata": {
      "put": {
        "operationId": "queryScopeSaveMetadata",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SaveQueryScopeMetadata" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseQueryScopeDetail" } }
            },
            "description": "OK"
          }
        },
        "tags": ["查询范围管理"]
      }
    },
    "/api/agent/query-scopes/{id}/views": {
      "put": {
        "operationId": "queryScopeReplaceViews",
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReplaceQueryScopeViews" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseDataSourceView" } }
            },
            "description": "OK"
          }
        },
        "tags": ["查询范围管理"]
      }
    }
  },
  "servers": [{ "url": "/" }],
  "tags": [
    {
      "description": "Agent 受控查询的数据源配置；密码只写不读，检查只读授权",
      "name": "数据源管理"
    },
    {
      "description": "维护允许查询的视图范围与视图/字段说明；列表不连接目标库",
      "name": "查询范围管理"
    }
  ]
}
