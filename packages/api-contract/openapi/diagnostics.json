{
  "components": {
    "schemas": {
      "ApiResponseBootstrapStatus": {
        "properties": {
          "code": { "type": "string" },
          "data": { "$ref": "#/components/schemas/BootstrapStatus" },
          "fieldErrors": {
            "description": "字段级校验错误；无字段错误时为 null",
            "items": { "$ref": "#/components/schemas/FieldError" },
            "type": "array"
          },
          "message": { "type": "string" },
          "requestId": { "type": "string" }
        },
        "required": ["code", "data", "message", "requestId"],
        "type": "object"
      },
      "ApiResponseProbeRecord": {
        "properties": {
          "code": { "type": "string" },
          "data": { "$ref": "#/components/schemas/ProbeRecord" },
          "fieldErrors": {
            "description": "字段级校验错误；无字段错误时为 null",
            "items": { "$ref": "#/components/schemas/FieldError" },
            "type": "array"
          },
          "message": { "type": "string" },
          "requestId": { "type": "string" }
        },
        "required": ["code", "data", "message", "requestId"],
        "type": "object"
      },
      "BootstrapStatus": {
        "properties": {
          "application": { "type": "string" },
          "database": { "type": "string" },
          "recentProbes": {
            "items": { "$ref": "#/components/schemas/ProbeRecord" },
            "type": "array"
          },
          "serverTime": { "format": "date-time", "type": "string" },
          "totalProbes": { "format": "int64", "type": "integer" }
        },
        "required": ["application", "database", "recentProbes", "serverTime", "totalProbes"],
        "type": "object"
      },
      "CreateProbe": {
        "properties": { "note": { "maxLength": 120, "minLength": 0, "type": "string" } },
        "required": ["note"],
        "type": "object"
      },
      "FieldError": {
        "properties": { "field": { "type": "string" }, "message": { "type": "string" } },
        "required": ["field", "message"],
        "type": "object"
      },
      "ProbeRecord": {
        "properties": {
          "createdAt": { "format": "date-time", "type": "string" },
          "id": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["createdAt", "id", "note"],
        "type": "object"
      }
    }
  },
  "info": { "title": "OpenAPI definition", "version": "v0" },
  "openapi": "3.1.0",
  "paths": {
    "/api/bootstrap": {
      "get": {
        "operationId": "bootstrapStatus",
        "responses": {
          "200": {
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseBootstrapStatus" } }
            },
            "description": "OK"
          }
        },
        "summary": "查询本地工程与数据库联调状态",
        "tags": ["bootstrap-controller"]
      }
    },
    "/api/bootstrap/probes": {
      "post": {
        "operationId": "bootstrapCreate",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateProbe" } }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseProbeRecord" } }
            },
            "description": "Created"
          }
        },
        "summary": "写入一条本地合成联调记录",
        "tags": ["bootstrap-controller"]
      }
    }
  },
  "servers": [{ "url": "/" }]
}
