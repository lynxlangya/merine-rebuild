{
  "components": {
    "schemas": {
      "ApiResponseAuthUserResponse": {
        "properties": {
          "code": { "type": "string" },
          "data": { "$ref": "#/components/schemas/AuthUserResponse" },
          "fieldErrors": {
            "description": "字段级校验错误；无字段错误时为 null",
            "items": { "$ref": "#/components/schemas/FieldError" },
            "type": "array"
          },
          "message": { "type": "string" },
          "requestId": { "type": "string" }
        },
        "required": ["code", "data", "message", "requestId"],
        "type": "object"
      },
      "ApiResponseListDevLoginAccountOption": {
        "properties": {
          "code": { "type": "string" },
          "data": {
            "items": { "$ref": "#/components/schemas/DevLoginAccountOption" },
            "type": "array"
          },
          "fieldErrors": {
            "description": "字段级校验错误；无字段错误时为 null",
            "items": { "$ref": "#/components/schemas/FieldError" },
            "type": "array"
          },
          "message": { "type": "string" },
          "requestId": { "type": "string" }
        },
        "required": ["code", "data", "message", "requestId"],
        "type": "object"
      },
      "ApiResponseVoid": {
        "properties": {
          "code": { "type": "string" },
          "data": {},
          "fieldErrors": {
            "description": "字段级校验错误；无字段错误时为 null",
            "items": { "$ref": "#/components/schemas/FieldError" },
            "type": "array"
          },
          "message": { "type": "string" },
          "requestId": { "type": "string" }
        },
        "required": ["code", "data", "message", "requestId"],
        "type": "object"
      },
      "AuthUserResponse": {
        "properties": {
          "authorizationVersion": {
            "description": "授权版本；角色、角色权限或单位变化时递增，旧会话据此失效",
            "format": "int32",
            "type": "integer"
          },
          "displayName": { "type": "string" },
          "id": { "type": "string" },
          "loginName": { "type": "string" },
          "permissionCodes": {
            "description": "有效功能权限码；内置管理员角色已在此展开为全部权限码",
            "items": { "type": "string" },
            "type": "array"
          },
          "roleCodes": {
            "description": "角色编码，按编码升序，与 roleNames 下标一一对应",
            "items": { "type": "string" },
            "type": "array"
          },
          "roleNames": { "items": { "type": "string" }, "type": "array" },
          "unitName": { "type": "string" }
        },
        "required": [
          "authorizationVersion",
          "displayName",
          "id",
          "loginName",
          "permissionCodes",
          "roleCodes",
          "roleNames",
          "unitName"
        ],
        "type": "object"
      },
      "CsrfToken": {
        "properties": {
          "headerName": { "type": "string" },
          "parameterName": { "type": "string" },
          "token": { "type": "string" }
        },
        "type": "object"
      },
      "DevLoginAccountOption": {
        "properties": {
          "displayName": { "type": "string" },
          "loginName": { "type": "string" },
          "parentUnitName": {
            "description": "直属上级单位名称；总队为 null",
            "type": ["string", "null"]
          },
          "unitLevel": {
            "description": "1 总队，2 支队，3 大队",
            "format": "int32",
            "type": "integer"
          },
          "unitName": { "type": "string" }
        },
        "required": ["displayName", "loginName", "unitLevel", "unitName"],
        "type": "object"
      },
      "DevLoginRequest": {
        "properties": {
          "loginName": { "maxLength": 64, "minLength": 0, "type": "string" },
          "rememberMe": { "type": "boolean" }
        },
        "required": ["loginName"],
        "type": "object"
      },
      "FieldError": {
        "properties": { "field": { "type": "string" }, "message": { "type": "string" } },
        "required": ["field", "message"],
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "loginName": { "maxLength": 64, "minLength": 0, "type": "string" },
          "password": {
            "description": "UTF-8 编码不超过 72 字节",
            "maxLength": 72,
            "minLength": 0,
            "type": "string"
          },
          "rememberMe": {
            "description": "勾选后延长本次会话的空闲超时；省略或为 null 表示不保持登录",
            "type": "boolean"
          }
        },
        "required": ["loginName", "password"],
        "type": "object"
      }
    }
  },
  "info": { "title": "OpenAPI definition", "version": "v0" },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/csrf": {
      "get": {
        "operationId": "authCsrf",
        "parameters": [
          {
            "in": "query",
            "name": "csrfToken",
            "required": true,
            "schema": { "$ref": "#/components/schemas/CsrfToken" }
          }
        ],
        "responses": {
          "200": {
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseVoid" } } },
            "description": "OK"
          }
        },
        "summary": "获取 CSRF 令牌",
        "tags": ["认证"]
      }
    },
    "/api/auth/dev/accounts": {
      "get": {
        "operationId": "devLoginAccounts",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseListDevLoginAccountOption" }
              }
            },
            "description": "OK"
          }
        },
        "summary": "列出本地开发环境可登录的账号",
        "tags": ["dev-login-controller"]
      }
    },
    "/api/auth/dev/session": {
      "post": {
        "operationId": "devLoginLogin",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/DevLoginRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseAuthUserResponse" } }
            },
            "description": "OK"
          }
        },
        "summary": "本地开发环境选择账号建立会话",
        "tags": ["dev-login-controller"]
      }
    },
    "/api/auth/session": {
      "delete": {
        "operationId": "authLogout",
        "responses": {
          "200": {
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseVoid" } } },
            "description": "OK"
          }
        },
        "summary": "退出并作废当前会话",
        "tags": ["认证"]
      },
      "get": {
        "operationId": "authCurrent",
        "responses": {
          "200": {
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseAuthUserResponse" } }
            },
            "description": "OK"
          }
        },
        "summary": "获取当前身份",
        "tags": ["认证"]
      },
      "post": {
        "operationId": "authLogin",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseAuthUserResponse" } }
            },
            "description": "OK"
          }
        },
        "summary": "登录并建立会话",
        "tags": ["认证"]
      }
    }
  },
  "servers": [{ "url": "/" }],
  "tags": [
    { "description": "登录、退出与当前身份；会话保存在服务端，Cookie 只带会话标识", "name": "认证" }
  ]
}
