# Run ./scripts/dev.sh setup to generate .env with independent local passwords.
# These values apply only when creating a new MySQL volume.
MYSQL_ROOT_PASSWORD=generated_by_setup
MYSQL_MIGRATION_PASSWORD=generated_by_setup
MYSQL_APP_PASSWORD=generated_by_setup
# 隔离测试库 merine_rebuild_test 的 DML 账号密码；由 ./scripts/dev.sh test-db 使用
MYSQL_TEST_PASSWORD=generated_by_setup
# 模型供应商 AES-256-GCM 主密钥：setup 自动生成 64 个十六进制字符。
# 与数据库分别备份；已有密文后不可直接重新生成。只注入后端，不使用 VITE_ 前缀。
MODEL_PROVIDER_ENCRYPTION_KEY=generated_by_setup
